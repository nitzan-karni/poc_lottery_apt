# ============================================================
# Railway Environment Variables Reference
# ============================================================
# Set these in the Railway dashboard for each service.
# Variables marked [auto] are provided automatically by Railway add-ons.
# ============================================================

# ---- BACKEND SERVICE & WORKER SERVICE ----

# Database (PostgreSQL add-on) [auto]
DATABASE_URL=postgresql://user:pass@host:5432/railway

# Redis (Redis add-on) [auto]
REDIS_URL=redis://default:pass@host:6379

# S3-compatible file storage (AWS S3 or Cloudflare R2 — NOT MinIO)
S3_BUCKET=lottery-documents
S3_REGION=us-east-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_ENDPOINT=                   # Leave empty for AWS S3. For Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com

# AI document verification
OPENAI_API_KEY=sk-...

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=Ezra VaBitaron <noreply@lottery.e-b.co.il>

# Auth / JWT
SECRET_KEY=generate-a-long-random-string-here   # e.g. openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App URLs (use your actual Railway service public domains)
APP_URL=https://your-frontend.railway.app
BACKEND_URL=https://your-backend.railway.app

# CORS — must include the frontend Railway domain (JSON array as a string)
CORS_ORIGINS=["https://your-frontend.railway.app"]

# ---- FRONTEND SERVICE ----

# Points to the backend Railway service public URL
NEXT_PUBLIC_API_URL=https://your-backend.railway.app

# ---- WORKER SERVICE ----
# The worker is a SEPARATE Railway service using the same backend Docker image.
# In the Railway UI: set the "Start Command" override to:
#   python -m rq worker verification --url $REDIS_URL
#
# Required env vars for the worker (same as backend):
#   DATABASE_URL, REDIS_URL, S3_*, OPENAI_API_KEY
